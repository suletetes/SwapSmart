# ─── SwapSmart Frontend Environment Variables ─────────────────────────────────
# Copy this file to .env.local and fill in the values from your AWS deployment.

# API Gateway REST API URL (e.g., https://abc123.execute-api.af-south-1.amazonaws.com/dev)
NEXT_PUBLIC_API_URL=

# WebSocket API URL (e.g., wss://xyz789.execute-api.af-south-1.amazonaws.com/dev)
NEXT_PUBLIC_WS_URL=

# Cognito User Pool ID (e.g., af-south-1_AbCdEfGhI)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=

# Cognito App Client ID (e.g., 1a2b3c4d5e6f7g8h9i0j)
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Amazon Location Service — Map resource name
NEXT_PUBLIC_MAP_NAME=

# Amazon Location Service — Place Index name (for geocoding/search)
NEXT_PUBLIC_PLACE_INDEX_NAME=

# Amazon Location Service — Route Calculator name (for ETA/routing)
NEXT_PUBLIC_ROUTE_CALCULATOR_NAME=

# ─── Deployment Variables (used by scripts/deploy.sh) ─────────────────────────
# S3 bucket name for static assets
S3_BUCKET=

# CloudFront distribution ID
CLOUDFRONT_DISTRIBUTION_ID=
